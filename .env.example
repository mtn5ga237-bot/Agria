SECRET_KEY=change-moi-en-production-avec-une-cle-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Laisser vide en developpement (SQLite est alors utilise automatiquement)
# En production : postgres://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

ADMIN_EMAIL=admin@agria.local

# Assistant IA (Claude, cote serveur uniquement) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ASSISTANT_MAX_MESSAGES_PAR_HEURE=30

# Connexion via Google (console.cloud.google.com > APIs & Services > Identifiants)
# Origine JavaScript autorisee : http://localhost:8000
# URI de redirection autorisee : http://localhost:8000/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SMTP (reinitialisation de mot de passe)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AgriA <noreply@agria.local>
